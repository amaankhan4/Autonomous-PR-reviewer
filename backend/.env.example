# Autonomous PR Reviewer -- backend configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Every variable below is optional: the defaults boot a fully working demo with
# a mock GitHub App, a mock LLM and an in-memory vector store.

# ---------------------------------------------------------------------- app
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------ secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ----------------------------------------------------------------- database
# Async driver required (asyncpg). SQLite also works: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prreviewer

# -------------------------------------------------------------------- redis
# Option A -- local Redis:
REDIS_URL=redis://localhost:6379/0
# Option B -- Upstash (serverless, no Docker needed). When both UPSTASH_REDIS_*
# values are set they take precedence and a `rediss://` broker URL is derived
# automatically: the REST token doubles as the TCP password.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set true to run review jobs in-process without any broker at all.
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------- github
# Leave MOCK_GITHUB=true to run demo mode with no GitHub credentials.
MOCK_GITHUB=true
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------------------- ai
# mock | openai | gemini
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
# Fail loudly instead of silently falling back to the mock provider.
LLM_STRICT_PROVIDER=false

# ---------------------------------------------------------------- embedding
# `hashing` is deterministic and needs no API key.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384

# ------------------------------------------------------------- vector store
# memory | qdrant | upstash
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Upstash Vector: create a DENSE index with dimension == EMBEDDING_DIM,
# COSINE similarity, and NO hosted embedding model (this app sends its own
# vectors). One namespace per repository is created automatically.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ------------------------------------------------------------- review caps
PUBLISH_REVIEWS=true
DEFAULT_REVIEW_EVENT=COMMENT
MIN_PUBLISH_CONFIDENCE=0.55
DEFAULT_MIN_SEVERITY=LOW
MAX_CHANGED_FILES=60

# --------------------------------------------------------- static analysis
ENABLE_STATIC_ANALYSIS=true
# mypy is accurate but slow to cold-start, so it is opt-in.
STATIC_MYPY_ENABLED=false

# ------------------------------------------------------------------- demo
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@prreviewer.dev
DEMO_USER_PASSWORD=demo12345
