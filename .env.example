# Overrides for `docker compose`. Copy to `.env` (gitignored) and edit.
#
# The compose stack already works with no .env at all: it runs entirely on
# mocks with a bundled Postgres, Redis and Qdrant. Everything below is opt-in.

# ------------------------------------------------------------------- ports
API_PORT=8000
WEB_PORT=3000

# ----------------------------------------------------------------- secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# --------------------------------------------------------------------- app
ENVIRONMENT=staging
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO_DATA=true

# ---------------------------------------------------- real GitHub App (opt-in)
# MOCK_GITHUB=false
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# ----------------------------------------------------------- real LLM (opt-in)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --------------------------------------------------------------- retrieval
# `hashing` is offline and deterministic; `openai` gives real retrieval quality.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
VECTOR_STORE=qdrant
QDRANT_COLLECTION=repo_context
